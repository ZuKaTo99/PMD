@page "/projektpruefung"
@namespace PMD.App.Features.Scanner.Pages
@using PMD.App.Features.Scanner.Components

<PageTitle>PMD - Projektprüfung</PageTitle>

<div class="container-fluid pmd-scanner-page">
    <ProjectScannerPageHeader />

    <ProjectFolderScanInputCard @bind-FolderPath="folderPath"
                                ErrorMessage="@errorMessage"
                                IsScanning="@isScanOperationActive"
                                OnPickFolder="PickFolderAsync"
                                OnScanProjectFolder="ScanProjectFolderAsync" />

    @if (isScanOperationActive)
    {
        <ProjectScanProgressCard StatusText="@scanStatusText"
                                 Progress="@scanProgress"
                                 CanCancel="@CanCancelScan"
                                 OnCancel="CancelScan" />
    }

    <ScannerInfoMessage Message="@infoMessage" />

    @if (scanResult is not null)
    {
        <ScanSummaryView ScanResult="@scanResult" />

        <ProjectScanResultActionCard Project="@currentProject" />
    }
</div>