@namespace PMD.App.Features.Scanner.Components
@using Microsoft.AspNetCore.Components
@using System
@using System.Collections.Generic
@using System.Linq

@if (Warnings.Count > 0)
{
    <div class="alert alert-warning mt-4 mb-0">
        <div class="fw-semibold mb-2">
            Hinweise aus der Projektprüfung
        </div>

        <ul class="mb-0 ps-3">
            @foreach (string warning in VisibleWarnings)
            {
                <li class="mb-1 pmd-text-break">@warning</li>
            }
        </ul>

        <ProgressiveListControls TotalCount="@Warnings.Count"
                                 VisibleCount="@VisibleWarnings.Count"
                                 InitialCount="@InitialVisibleWarningCount"
                                 StepCount="@VisibleWarningStepCount"
                                 ItemLabel="Hinweise"
                                 OnShowMore="ShowMore"
                                 OnShowAll="ShowAll"
                                 OnCollapse="Collapse" />
    </div>
}

@code {
    private const int InitialVisibleWarningCount = 8;
    private const int VisibleWarningStepCount = 8;

    private int visibleWarningCount = InitialVisibleWarningCount;
    private int lastWarningCount = -1;
    private IReadOnlyList<string>? lastWarnings;

    [Parameter]
    public IReadOnlyList<string> Warnings { get; set; } = Array.Empty<string>();

    private IReadOnlyList<string> VisibleWarnings => Warnings
        .Take(visibleWarningCount)
        .ToList();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(lastWarnings, Warnings) ||
            Warnings.Count != lastWarningCount)
        {
            visibleWarningCount = InitialVisibleWarningCount;
            lastWarningCount = Warnings.Count;
            lastWarnings = Warnings;
        }
    }

    private void ShowMore()
    {
        visibleWarningCount = Math.Min(
            Warnings.Count,
            visibleWarningCount + VisibleWarningStepCount);
    }

    private void ShowAll()
    {
        visibleWarningCount = Warnings.Count;
    }

    private void Collapse()
    {
        visibleWarningCount = InitialVisibleWarningCount;
    }
}
