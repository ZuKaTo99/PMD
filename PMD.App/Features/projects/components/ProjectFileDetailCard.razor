@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectFiles
@using PMD.App.Domain.ProjectStates

<div class="card h-100">
    <div class="card-header">
        <h3 class="h6 mb-0">Dateidetails</h3>
    </div>

    <div class="card-body">
        @if (SelectedFile is null)
        {
            <p class="text-muted mb-0">
                Wähle eine Datei aus der Liste aus, um Details zu sehen.
            </p>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                <div>
                    <div class="text-muted small">Dateiname</div>
                    <div class="fw-semibold text-break">@SelectedFile.FileName</div>
                </div>

                <div>
                    <div class="text-muted small">Pfad im Projekt</div>
                    <code class="d-block text-break">@SelectedFile.RelativePath</code>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-12">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Dateityp</div>
                            <div class="fw-semibold">
                                @ProjectOverviewFormatter.FormatExtension(SelectedFile.Extension)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-12">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Größe</div>
                            <div class="fw-semibold">
                                @ProjectOverviewFormatter.FormatFileSize(SelectedFile.SizeInBytes)
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Zuletzt geändert</div>
                            <div class="fw-semibold">
                                @ProjectOverviewFormatter.FormatDateTime(SelectedFile.LastChangedAt)
                            </div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-outline-primary"
                        type="button"
                        @onclick="OnLoadPreview">
                    Vorschau laden
                </button>

                <ProjectFilePreviewCard PreviewResult="SelectedFileContentResult" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public ProjectStateFile? SelectedFile { get; set; }

    [Parameter]
    public ProjectFileContentResult? SelectedFileContentResult { get; set; }

    [Parameter]
    public EventCallback OnLoadPreview { get; set; }
}