@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Nächste Bereiche</h2>
    </div>

    <div class="card-body">
        <p class="text-muted">
            Die Projektseite bleibt die Zentrale. Details bekommen später eigene Bereiche,
            damit PMD nicht wie eine Tabellenansicht wirkt.
        </p>

        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-1">Änderungen ansehen</div>
                    <div class="text-muted small">
                        Die automatische Grundlage ist vorbereitet. Als Nächstes kann daraus
                        eine eigene Änderungsansicht entstehen.
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-1">Dateien und Code</div>
                    <div class="text-muted small">
                        Dateien werden später gezielt geöffnet und ausgewertet,
                        nicht als lange Tabelle auf der Projektseite.
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-1">Datenbank vorbereiten</div>
                    <div class="text-muted small">
                        Die Projektseite nutzt bereits eine zentrale Übersicht. Dadurch kann
                        der Speicher später auf SQLite umgestellt werden.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
