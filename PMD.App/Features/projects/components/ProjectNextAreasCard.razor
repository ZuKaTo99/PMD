@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Nächste Bereiche</h2>
    </div>

    <div class="card-body">
        <p class="text-muted">
            Die Projektseite bleibt die Zentrale. Detailansichten werden später gezielt geöffnet, nicht als lange Tabellen auf die Hauptseite gelegt.
        </p>

        <div class="row g-3">
            <div class="col-12 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="d-flex justify-content-between gap-2 mb-2">
                        <div class="fw-semibold">Datenbank</div>
                        <span class="badge bg-primary">Nächster Schritt</span>
                    </div>
                    <div class="text-muted small">
                        Projekte, Prüfungen und Dateien sollen dauerhaft in SQLite gespeichert werden.
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-2">Änderungen</div>
                    <div class="text-muted small">
                        Aus dem Verlauf entsteht später eine eigene, verständliche Änderungsansicht.
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-2">Dateien und Code</div>
                    <div class="text-muted small">
                        Dateien sollen gezielt geöffnet, gefiltert und später mit Codeansicht verstanden werden.
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-2">KI fragen</div>
                    <div class="text-muted small">
                        Die KI-Auswertung baut später auf gespeicherten Projekten, Prüfungen und Codeinformationen auf.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
