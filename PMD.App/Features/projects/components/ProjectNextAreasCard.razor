@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Nächste Bereiche</h2>
    </div>

    <div class="card-body">
        <p class="text-muted">
            Die Projektseite bleibt die Zentrale. Die Daten sind vorhanden, aber ausführliche Ansichten bekommen eigene Bereiche.
        </p>

        <div class="row g-3">
            <div class="col-12 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-1">Änderungen</div>
                    <div class="text-muted small">
                        Aus den letzten Prüfungen wird später eine eigene Änderungsansicht aufgebaut.
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-1">Dateien</div>
                    <div class="text-muted small">
                        Dateien sollen gezielt geöffnet, gefiltert und verstanden werden.
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-1">Code</div>
                    <div class="text-muted small">
                        Code-Auswertung wird später auf den gespeicherten Prüfungen aufbauen.
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold mb-1">Datenbank</div>
                    <div class="text-muted small">
                        Projekt, Verlauf und Prüfung sind bereits so gebündelt, dass SQLite als nächster großer Schritt passt.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
