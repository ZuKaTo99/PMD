@namespace PMD.App.Features.Projects.Components
@using System
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectStates
@using System.Linq

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Größere Dateien</h2>
    </div>

    <div class="card-body">
        @if (ProjectState is null || ProjectState.Files.Count == 0)
        {
            <p class="text-muted mb-0">Noch keine Dateien verfügbar.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var file in ProjectState.Files
                    .OrderByDescending(file => file.SizeInBytes)
                    .ThenBy(file => file.RelativePath)
                    .Take(6))
                {
                    <div class="col-12 col-xl-6">
                        <div class="border rounded p-3 h-100">
                            <code class="pmd-truncated-path" title="@file.RelativePath">@file.RelativePath</code>
                            <div class="text-muted small">@ProjectOverviewFormatter.FormatFileSize(file.SizeInBytes)</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public ProjectState? ProjectState { get; set; }
}
