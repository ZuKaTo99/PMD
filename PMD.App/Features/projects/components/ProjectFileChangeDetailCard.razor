@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectChanges
@using PMD.App.Domain.ProjectStates

<div class="card h-100 mb-4">
    <div class="card-header">
        <h3 class="h6 mb-0">Änderungsdetails</h3>
    </div>

    <div class="card-body">
        @if (SelectedChange is null)
        {
            <p class="text-muted mb-0">
                Wähle eine Änderung aus der Liste aus, um Details zu sehen.
            </p>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                <div>
                    <div class="text-muted small">Status</div>
                    <span class="badge bg-light text-dark border">
                        @FormatChangeKind(SelectedChange.ChangeKind)
                    </span>
                </div>

                <div>
                    <div class="text-muted small">Dateiname</div>
                    <div class="fw-semibold text-break">
                        @SelectedChange.FileName
                    </div>
                </div>

                <div>
                    <div class="text-muted small">Pfad im Projekt</div>
                    <code class="d-block text-break">
                        @SelectedChange.RelativePath
                    </code>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Dateityp</div>
                            <div class="fw-semibold">
                                @ProjectOverviewFormatter.FormatExtension(SelectedChange.Extension)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-12">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Vorherige Größe</div>
                            <div class="fw-semibold">
                                @FormatFileSize(SelectedChange.PreviousFile)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-12">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Letzte Größe</div>
                            <div class="fw-semibold">
                                @FormatFileSize(SelectedChange.LatestFile)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-12">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Vorher geändert</div>
                            <div class="fw-semibold">
                                @FormatLastChangedAt(SelectedChange.PreviousFile)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-12">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Zuletzt geändert</div>
                            <div class="fw-semibold">
                                @FormatLastChangedAt(SelectedChange.LatestFile)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-secondary mb-0">
                    Aktuell erkennt PMD Änderungen über Pfad, Größe und Änderungsdatum.
                    Ein genauer Code-Diff kommt später.
                </div>

                <a class="btn btn-outline-primary"
                   href="@($"/projekte/{ProjectId}/dateien")">
                    Dateien ansehen
                </a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public ProjectFileChange? SelectedChange { get; set; }

    private static string FormatFileSize(ProjectStateFile? file)
    {
        if (file is null)
        {
            return "Nicht vorhanden";
        }

        return ProjectOverviewFormatter.FormatFileSize(file.SizeInBytes);
    }

    private static string FormatLastChangedAt(ProjectStateFile? file)
    {
        if (file is null)
        {
            return "Nicht vorhanden";
        }

        return ProjectOverviewFormatter.FormatDateTime(file.LastChangedAt);
    }

    private static string FormatChangeKind(ProjectFileChangeKind changeKind)
    {
        return changeKind switch
        {
            ProjectFileChangeKind.Added => "Neue Datei",
            ProjectFileChangeKind.Modified => "Geänderte Datei",
            ProjectFileChangeKind.Removed => "Entfernte Datei",
            ProjectFileChangeKind.Unchanged => "Unverändert",
            _ => "Unbekannt"
        };
    }
}