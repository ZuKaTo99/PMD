@namespace PMD.App.Features.Projects.Components

@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectChanges
@using PMD.App.Domain.ProjectStates
@using System

<div class="card h-100 mb-4 pmd-card">
    <div class="card-header">
        <h3 class="h6 mb-0">Änderungsdetails</h3>
    </div>

    <div class="card-body">
        @if (SelectedChange is null)
        {
            <p class="text-muted mb-0">
                Wähle eine Änderung aus der Liste aus, um Details zu sehen.
            </p>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                <div class="pmd-detail-item">
                    <div class="text-muted small">Status</div>
                    <span class="badge bg-light text-dark border">
                        @FormatChangeKind(SelectedChange.ChangeKind)
                    </span>
                </div>

                <div class="pmd-detail-item">
                    <div class="text-muted small">Dateiname</div>
                    <div class="fw-semibold pmd-text-break">
                        @SelectedChange.FileName
                    </div>
                </div>

                <div class="pmd-detail-item">
                    <div class="text-muted small">Pfad im Projekt</div>
                    <code class="pmd-path" title="@SelectedChange.RelativePath">
                        @SelectedChange.RelativePath
                    </code>
                </div>

                <div class="border rounded p-3 pmd-card">
                    <div class="text-muted small mb-2">Erkannt durch</div>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (string reason in ChangeReasons)
                        {
                            <span class="badge bg-primary-subtle text-primary border">
                                @reason
                            </span>
                        }
                    </div>
                </div>

                @if (SelectedChange.ChangeKind == ProjectFileChangeKind.Modified)
                {
                    <div class="border rounded p-3 pmd-card">
                        <div class="text-muted small mb-2">Änderung im Überblick</div>

                        <div class="pmd-detail-grid">
                            <div class="border rounded p-3 h-100 bg-light pmd-detail-item">
                                <div class="text-muted small">Größenänderung</div>
                                <div class="fw-semibold">
                                    @FormatSizeDifference()
                                </div>
                            </div>

                            <div class="border rounded p-3 h-100 bg-light pmd-detail-item">
                                <div class="text-muted small">Zeitlicher Abstand</div>
                                <div class="fw-semibold">
                                    @FormatLastChangedDifference()
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="pmd-detail-grid">
                    <div class="border rounded p-3 h-100 pmd-detail-item">
                        <div class="text-muted small">Dateityp</div>
                        <div class="fw-semibold">
                            @ProjectOverviewFormatter.FormatExtension(SelectedChange.Extension)
                        </div>
                    </div>

                    <div class="border rounded p-3 h-100 pmd-detail-item">
                        <div class="text-muted small">Vorherige Größe</div>
                        <div class="fw-semibold">
                            @FormatFileSize(SelectedChange.PreviousFile)
                        </div>
                    </div>

                    <div class="border rounded p-3 h-100 pmd-detail-item">
                        <div class="text-muted small">Letzte Größe</div>
                        <div class="fw-semibold">
                            @FormatFileSize(SelectedChange.LatestFile)
                        </div>
                    </div>

                    <div class="border rounded p-3 h-100 pmd-detail-item">
                        <div class="text-muted small">Vorher geändert</div>
                        <div class="fw-semibold">
                            @FormatLastChangedAt(SelectedChange.PreviousFile)
                        </div>
                    </div>

                    <div class="border rounded p-3 h-100 pmd-detail-item">
                        <div class="text-muted small">Zuletzt geändert</div>
                        <div class="fw-semibold">
                            @FormatLastChangedAt(SelectedChange.LatestFile)
                        </div>
                    </div>
                </div>

                <div class="alert alert-secondary mb-0">
                    PMD nutzt Hash-Werte, wenn beide Prüfungen sie enthalten.
                    Für ältere Prüfungen bleibt Größe und Änderungsdatum die Grundlage.
                    Code-Abschnitte werden angezeigt, wenn gespeicherte Textauszüge vorhanden sind.
                </div>

                @if (CanShowCodeChangeSections)
                {
                    <ProjectCodeChangeSectionsCard FileChange="SelectedChange" />
                }
                else if (CanShowMissingTextSnapshotHint)
                {
                    <div class="alert alert-light border mb-0">
                        Für diese Datei gibt es keinen gespeicherten Textauszug.
                        Code-Abschnitte können deshalb nicht angezeigt werden.
                    </div>
                }

                @if (CanOpenLatestFile)
                {
                    <div class="pmd-responsive-actions">
                        <a class="btn btn-outline-primary"
                           href="@LatestFileDetailsLink">
                            Datei mit Vorschau öffnen
                        </a>
                    </div>
                }
                else
                {
                    <div class="pmd-responsive-actions">
                        <button class="btn btn-outline-secondary"
                                type="button"
                                disabled>
                            Datei nicht mehr vorhanden
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public ProjectFileChange? SelectedChange { get; set; }

    private bool CanOpenLatestFile =>
        SelectedChange?.LatestFile is not null;

    private bool CanShowCodeChangeSections =>
        SelectedChange is not null &&
        SelectedChange.ChangeKind != ProjectFileChangeKind.Unchanged &&
        HasAnyTextSnapshot;

    private bool CanShowMissingTextSnapshotHint =>
        SelectedChange is not null &&
        SelectedChange.ChangeKind != ProjectFileChangeKind.Unchanged &&
        !HasAnyTextSnapshot;

    private bool HasAnyTextSnapshot =>
        HasTextSnapshot(SelectedChange?.PreviousFile) ||
        HasTextSnapshot(SelectedChange?.LatestFile);

    private static bool HasTextSnapshot(ProjectStateFile? file)
    {
        return !string.IsNullOrWhiteSpace(file?.TextSnapshotContent);
    }

    private string LatestFileDetailsLink
    {
        get
        {
            if (SelectedChange?.LatestFile is null)
            {
                return "#";
            }

            string encodedRelativePath = Uri.EscapeDataString(
                SelectedChange.LatestFile.RelativePath);

            return $"/projekte/{ProjectId}/dateien?datei={encodedRelativePath}&quelle=aenderungen";
        }
    }

    private IReadOnlyList<string> ChangeReasons
    {
        get
        {
            if (SelectedChange is null)
            {
                return Array.Empty<string>();
            }

            return SelectedChange.ChangeKind switch
            {
                ProjectFileChangeKind.Added => new[] { "Neue Datei" },
                ProjectFileChangeKind.Removed => new[] { "Datei entfernt" },
                ProjectFileChangeKind.Unchanged => new[] { "Keine auffällige Änderung" },
                ProjectFileChangeKind.Modified => GetModifiedChangeReasons(),
                _ => new[] { "Unbekannte Änderung" }
            };
        }
    }

    private IReadOnlyList<string> GetModifiedChangeReasons()
    {
        List<string> reasons = new();

        if (SelectedChange?.PreviousFile is null || SelectedChange.LatestFile is null)
        {
            reasons.Add("Dateidaten unvollständig");
            return reasons;
        }

        if (HasUsableContentHashes(
            SelectedChange.PreviousFile,
            SelectedChange.LatestFile) &&
            !string.Equals(
                SelectedChange.PreviousFile.ContentHashSha256,
                SelectedChange.LatestFile.ContentHashSha256,
                StringComparison.OrdinalIgnoreCase))
        {
            reasons.Add("Inhalt geändert");
        }

        if (SelectedChange.PreviousFile.SizeInBytes != SelectedChange.LatestFile.SizeInBytes)
        {
            reasons.Add("Größe geändert");
        }

        if (SelectedChange.PreviousFile.LastChangedAt != SelectedChange.LatestFile.LastChangedAt)
        {
            reasons.Add("Änderungsdatum geändert");
        }

        if (reasons.Count == 0)
        {
            reasons.Add("Änderung erkannt");
        }

        return reasons;
    }

    private static bool HasUsableContentHashes(
        ProjectStateFile previousFile,
        ProjectStateFile latestFile)
    {
        return !string.IsNullOrWhiteSpace(previousFile.ContentHashSha256) &&
            !string.IsNullOrWhiteSpace(latestFile.ContentHashSha256);
    }

    private string FormatSizeDifference()
    {
        if (SelectedChange?.PreviousFile is null || SelectedChange.LatestFile is null)
        {
            return "Nicht berechenbar";
        }

        long difference =
            SelectedChange.LatestFile.SizeInBytes -
            SelectedChange.PreviousFile.SizeInBytes;

        if (difference == 0)
        {
            return "Keine Größenänderung";
        }

        string prefix = difference > 0 ? "+" : "-";
        long absoluteDifference = Math.Abs(difference);

        return $"{prefix}{ProjectOverviewFormatter.FormatFileSize(absoluteDifference)}";
    }

    private string FormatLastChangedDifference()
    {
        if (SelectedChange?.PreviousFile is null || SelectedChange.LatestFile is null)
        {
            return "Nicht berechenbar";
        }

        TimeSpan difference =
            SelectedChange.LatestFile.LastChangedAt -
            SelectedChange.PreviousFile.LastChangedAt;

        if (difference == TimeSpan.Zero)
        {
            return "Kein Zeitunterschied";
        }

        TimeSpan absoluteDifference = difference.Duration();

        if (absoluteDifference.TotalDays >= 1)
        {
            return $"{absoluteDifference.TotalDays:0.#} Tage";
        }

        if (absoluteDifference.TotalHours >= 1)
        {
            return $"{absoluteDifference.TotalHours:0.#} Stunden";
        }

        if (absoluteDifference.TotalMinutes >= 1)
        {
            return $"{absoluteDifference.TotalMinutes:0.#} Minuten";
        }

        return $"{absoluteDifference.TotalSeconds:0.#} Sekunden";
    }

    private static string FormatFileSize(ProjectStateFile? file)
    {
        if (file is null)
        {
            return "Nicht vorhanden";
        }

        return ProjectOverviewFormatter.FormatFileSize(file.SizeInBytes);
    }

    private static string FormatLastChangedAt(ProjectStateFile? file)
    {
        if (file is null)
        {
            return "Nicht vorhanden";
        }

        return ProjectOverviewFormatter.FormatDateTime(file.LastChangedAt);
    }

    private static string FormatChangeKind(ProjectFileChangeKind changeKind)
    {
        return changeKind switch
        {
            ProjectFileChangeKind.Added => "Neue Datei",
            ProjectFileChangeKind.Modified => "Geänderte Datei",
            ProjectFileChangeKind.Removed => "Entfernte Datei",
            ProjectFileChangeKind.Unchanged => "Unverändert",
            _ => "Unbekannt"
        };
    }
}