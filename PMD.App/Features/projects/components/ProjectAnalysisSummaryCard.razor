@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Application.Projects

<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
            <div>
                <h2 class="h5 mb-1">Projektinhalt</h2>
                <div class="text-muted small">
                    PMD fasst die Daten zusammen, ohne die Projektseite zur Dateiliste zu machen.
                </div>
            </div>

            @if (Overview?.ContentSummary.HasData == true)
            {
                <span class="badge bg-secondary align-self-start align-self-lg-center">
                    Aus letzter Prüfung
                </span>
            }
        </div>
    </div>

    <div class="card-body">
        @if (Overview is null || !Overview.ContentSummary.HasData)
        {
            <p class="text-muted mb-0">
                Nach der ersten Prüfung kann PMD den Projektinhalt einordnen.
            </p>
        }
        else
        {
            var summary = Overview.ContentSummary;

            <div class="border rounded p-3 mb-3">
                <div class="text-muted small">Projektprofil</div>
                <div class="h5 mb-1">@summary.ProfileLabel</div>
                <div class="text-muted">@summary.ShortDescription</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Code-/Projektdateien</div>
                        <div class="fs-5 fw-semibold">@summary.CodeFileCount</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Konfiguration</div>
                        <div class="fs-5 fw-semibold">@summary.ConfigFileCount</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Text / Doku</div>
                        <div class="fs-5 fw-semibold">@summary.TextFileCount</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Weitere Dateien</div>
                        <div class="fs-5 fw-semibold">@summary.OtherFileCount</div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-xl-6">
                    <div class="border rounded p-3 h-100">
                        <div class="fw-semibold mb-2">Häufige Dateitypen</div>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var fileType in summary.FrequentFileTypes)
                            {
                                <span class="badge bg-light text-dark border">
                                    @fileType.Extension · @fileType.FileCount
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="border rounded p-3 h-100">
                        <div class="fw-semibold mb-2">Größere Dateien erkannt</div>

                        @if (summary.LargerFiles.Count == 0)
                        {
                            <div class="text-muted small">Keine Dateien vorhanden.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var file in summary.LargerFiles)
                                {
                                    <div class="d-flex justify-content-between gap-3">
                                        <span class="text-truncate">@file.FileName</span>
                                        <span class="text-muted small text-nowrap">
                                            @ProjectOverviewFormatter.FormatFileSize(file.SizeInBytes)
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="alert alert-light border mt-3 mb-0">
                Die ausführlichen Daten bleiben gespeichert. Eigene Bereiche für Dateien, Code und Änderungen
                können darauf aufbauen, ohne die Projektzentrale zu überladen.
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public ProjectOverview? Overview { get; set; }
}
