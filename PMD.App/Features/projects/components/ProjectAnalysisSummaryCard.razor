@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Application.Projects
@using System.Linq

<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
            <div>
                <h2 class="h5 mb-1">Projektinhalt</h2>
                <div class="text-muted small">
                    PMD zeigt, welche Dateiarten und Dateigruppen im Projekt vorhanden sind, ohne daraus eine lange Dateitabelle zu machen.
                </div>
            </div>

            @if (Overview?.ContentSummary.HasData == true)
            {
                <span class="badge bg-secondary align-self-start align-self-lg-center">
                    Aus letzter Prüfung
                </span>
            }
        </div>
    </div>

    <div class="card-body">
        @if (Overview is null || !Overview.ContentSummary.HasData)
        {
            <p class="text-muted mb-0">
                Nach der ersten Prüfung kann PMD den Projektinhalt einordnen.
            </p>
        }
        else
        {
            var summary = Overview.ContentSummary;

            <div class="border rounded p-3 mb-3">
                <div class="text-muted small">Projektprofil</div>
                <div class="h5 mb-1">@summary.ProfileLabel</div>
                <div class="text-muted">@summary.ShortDescription</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Code-/Projektdateien</div>
                        <div class="fs-5 fw-semibold">@summary.CodeFileCount</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Konfiguration</div>
                        <div class="fs-5 fw-semibold">@summary.ConfigFileCount</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Text / Doku</div>
                        <div class="fs-5 fw-semibold">@summary.TextFileCount</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Weitere Dateien</div>
                        <div class="fs-5 fw-semibold">@summary.OtherFileCount</div>
                    </div>
                </div>
            </div>

            <div class="border rounded p-3 mb-3">
                <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mb-2">
                    <div>
                        <div class="fw-semibold">Alle Dateitypen</div>
                        <div class="text-muted small">
                            Alle erkannten Dateiendungen aus der letzten Prüfung.
                        </div>
                    </div>

                    <span class="badge bg-light text-dark border align-self-start align-self-lg-center">
                        @summary.DifferentFileTypeCount Dateitypen
                    </span>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var fileType in VisibleFileTypes)
                    {
                        <span class="badge bg-light text-dark border">
                            @fileType.Extension · @fileType.FileCount
                        </span>
                    }
                </div>

                <ProgressiveListControls TotalCount="@summary.AllFileTypes.Count"
                                         VisibleCount="@VisibleFileTypes.Count"
                                         InitialCount="@InitialVisibleFileTypeCount"
                                         StepCount="@VisibleFileTypeStepCount"
                                         ItemLabel="Dateitypen"
                                         OnShowMore="ShowMoreFileTypes"
                                         OnShowAll="ShowAllFileTypes"
                                         OnCollapse="CollapseFileTypes" />
            </div>

            <div class="border rounded p-3 mb-3">
                <div class="fw-semibold mb-1">Dateien im Projekt</div>
                <div class="text-muted small mb-3">
                    PMD zeigt eine Auswahl nach Dateigruppe. Die vollständige Liste steht in der Dateiansicht bereit.
                </div>

                <div class="row g-3">
                    @foreach (var fileGroup in summary.FileGroups.Where(group => group.FileCount > 0))
                    {
                        <div class="col-12 col-xl-6">
                            <div class="border rounded p-3 h-100">
                                <div class="d-flex justify-content-between gap-3 mb-1">
                                    <div>
                                        <div class="fw-semibold">@fileGroup.Title</div>
                                        <div class="text-muted small">@fileGroup.Description</div>
                                    </div>

                                    <span class="badge bg-light text-dark border align-self-start">
                                        @fileGroup.FileCount Dateien
                                    </span>
                                </div>

                                <div class="d-flex flex-column gap-2 mt-3">
                                    @foreach (var file in fileGroup.Files)
                                    {
                                        <div class="d-flex justify-content-between gap-3">
                                            <code class="pmd-truncated-path" title="@file.RelativePath">@file.RelativePath</code>
                                            <span class="text-muted small text-nowrap">
                                                @ProjectOverviewFormatter.FormatFileSize(file.SizeInBytes)
                                            </span>
                                        </div>
                                    }
                                </div>

                                @if (fileGroup.FileCount > fileGroup.Files.Count)
                                {
                                    <div class="text-muted small mt-2">
                                        + @(fileGroup.FileCount - fileGroup.Files.Count) weitere Dateien in dieser Gruppe.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="border rounded p-3">
                <div class="fw-semibold mb-2">Größere Dateien erkannt</div>

                @if (summary.LargerFiles.Count == 0)
                {
                    <div class="text-muted small">Keine Dateien vorhanden.</div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var file in summary.LargerFiles)
                        {
                            <div class="col-12 col-lg-6">
                                <div class="d-flex justify-content-between gap-3 border rounded p-2 h-100">
                                    <span class="pmd-truncated-text" title="@file.RelativePath">@file.FileName</span>
                                    <span class="text-muted small text-nowrap">
                                        @ProjectOverviewFormatter.FormatFileSize(file.SizeInBytes)
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private const int InitialVisibleFileTypeCount = 12;
    private const int VisibleFileTypeStepCount = 12;

    private int visibleFileTypeCount = InitialVisibleFileTypeCount;
    private int lastFileTypeCount = -1;
    private Guid? lastProjectId;

    [Parameter]
    public ProjectOverview? Overview { get; set; }

    private IReadOnlyList<ProjectFileTypeSummary> VisibleFileTypes
    {
        get
        {
            if (Overview is null)
            {
                return Array.Empty<ProjectFileTypeSummary>();
            }

            return Overview.ContentSummary.AllFileTypes
                .Take(visibleFileTypeCount)
                .ToList();
        }
    }

    protected override void OnParametersSet()
    {
        int currentFileTypeCount =
            Overview?.ContentSummary.AllFileTypes.Count ?? 0;
        Guid? currentProjectId = Overview?.Project.Id;

        if (currentFileTypeCount != lastFileTypeCount ||
            currentProjectId != lastProjectId)
        {
            visibleFileTypeCount = InitialVisibleFileTypeCount;
            lastFileTypeCount = currentFileTypeCount;
            lastProjectId = currentProjectId;
        }
    }

    private void ShowMoreFileTypes()
    {
        int totalCount = Overview?.ContentSummary.AllFileTypes.Count ?? 0;
        visibleFileTypeCount = Math.Min(
            totalCount,
            visibleFileTypeCount + VisibleFileTypeStepCount);
    }

    private void ShowAllFileTypes()
    {
        visibleFileTypeCount =
            Overview?.ContentSummary.AllFileTypes.Count ?? 0;
    }

    private void CollapseFileTypes()
    {
        visibleFileTypeCount = InitialVisibleFileTypeCount;
    }
}
