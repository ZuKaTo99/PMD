@namespace PMD.App.Features.Projects.Components
@using System
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectStates
@using System.Linq

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Dateitypen</h2>
    </div>

    <div class="card-body">
        @if (ProjectState is null || ProjectState.Files.Count == 0)
        {
            <p class="text-muted mb-0">Noch keine Dateitypen verfügbar.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var fileType in GetFileTypeSummaries())
                {
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="border rounded p-3 h-100">
                            <div class="fw-semibold">@fileType.Extension</div>
                            <div class="text-muted small">@fileType.FileCount Dateien</div>
                            <div class="text-muted small">@ProjectOverviewFormatter.FormatFileSize(fileType.TotalSizeInBytes)</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public ProjectState? ProjectState { get; set; }

    private IReadOnlyList<FileTypeSummary> GetFileTypeSummaries()
    {
        if (ProjectState is null)
        {
            return Array.Empty<FileTypeSummary>();
        }

        return ProjectState.Files
            .GroupBy(file => ProjectOverviewFormatter.FormatExtension(file.Extension))
            .Select(group => new FileTypeSummary(
                group.Key,
                group.Count(),
                group.Sum(file => file.SizeInBytes)))
            .OrderByDescending(fileType => fileType.FileCount)
            .ThenBy(fileType => fileType.Extension)
            .Take(8)
            .ToList();
    }

    private sealed record FileTypeSummary(
        string Extension,
        int FileCount,
        long TotalSizeInBytes);
}
