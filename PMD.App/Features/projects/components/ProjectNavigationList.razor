@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components.Routing
@using PMD.App.Application.Projects
@using PMD.App.Domain.Projects
@inject IProjectMemoryStore ProjectMemoryStore
@implements IDisposable

@if (ProjectMemoryStore.Projects.Count > 0)
{
    <section class="project-navigation-section">
        <div class="project-navigation-title">
            Meine Projekte
        </div>

        <div class="project-navigation-list">
            @foreach (Project project in ProjectMemoryStore.Projects)
            {
                <NavLink class="project-navigation-link" href="@($"projekte/{project.Id}")">
                    <span class="project-navigation-icon" aria-hidden="true">P</span>

                    <span class="project-navigation-content">
                        <span class="project-navigation-name">@project.Name</span>
                        <span class="project-navigation-path">@GetShortProjectPath(project.RootPath)</span>
                    </span>
                </NavLink>
            }
        </div>
    </section>
}

@code {
    protected override void OnInitialized()
    {
        ProjectMemoryStore.ProjectsChanged += OnProjectsChanged;
    }

    private void OnProjectsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string GetShortProjectPath(string rootPath)
    {
        if (string.IsNullOrWhiteSpace(rootPath))
        {
            return "Projektordner";
        }

        string normalizedPath = rootPath.TrimEnd('\\', '/');
        string folderName = System.IO.Path.GetFileName(normalizedPath);

        if (string.IsNullOrWhiteSpace(folderName))
        {
            return "Projektordner";
        }

        return folderName;
    }

    public void Dispose()
    {
        ProjectMemoryStore.ProjectsChanged -= OnProjectsChanged;
    }
}
