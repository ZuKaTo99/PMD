@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using System
@using System.Collections.Generic
@using PMD.App.Application.Projects
@using PMD.App.Domain.Projects
@inject IProjectMemoryStore ProjectMemoryStore
@inject NavigationManager NavigationManager
@implements IDisposable

@if (ProjectMemoryStore.Projects.Count > 0)
{
    <section class="project-navigation-section" aria-label="Meine Projekte">
        <div class="project-navigation-header">
            <span>Meine Projekte</span>
            <span class="project-navigation-count">@ProjectMemoryStore.Projects.Count</span>
        </div>

        <div class="project-navigation-list">
            @foreach (Project project in ProjectMemoryStore.Projects)
            {
                <div class="project-navigation-entry">
                    <div class="project-navigation-card-row">
                        <NavLink class="@GetProjectCardCssClass(project)" href="@($"projekte/{project.Id}")" title="@project.RootPath">
                            <span class="@GetProjectMarkerCssClass(project)" aria-hidden="true">
                                @GetProjectInitials(project.Name)
                            </span>

                            <span class="project-navigation-content">
                                <span class="project-navigation-name">@project.Name</span>
                                <span class="project-navigation-meta">
                                    Geprüft @FormatNavigationDate(project.LastScannedAt)
                                </span>
                            </span>
                        </NavLink>

                        <div class="project-navigation-actions">
                            <button class="project-navigation-action-button project-navigation-edit-button"
                                    type="button"
                                    title="Projekt bearbeiten"
                                    aria-label="Projekt bearbeiten"
                                    @onclick="() => StartProjectEdit(project)">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="16"
                                     height="16"
                                     fill="currentColor"
                                     class="project-navigation-action-icon"
                                     viewBox="0 0 16 16"
                                     aria-hidden="true"
                                     focusable="false">
                                    <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                    <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                </svg>
                            </button>

                            <button class="project-navigation-action-button project-navigation-remove-button"
                                    type="button"
                                    title="Projekt aus PMD entfernen"
                                    aria-label="Projekt aus PMD entfernen"
                                    @onclick="() => StartProjectRemoval(project)">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="16"
                                     height="16"
                                     fill="currentColor"
                                     class="project-navigation-action-icon"
                                     viewBox="0 0 16 16"
                                     aria-hidden="true"
                                     focusable="false">
                                    <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    @if (ProjectPendingEdit?.Id == project.Id)
                    {
                        <div class="project-navigation-edit-panel">
                            <div class="project-navigation-edit-title">
                                Projekt bearbeiten
                            </div>

                            <p>
                                Geändert werden nur Anzeigename und Farbe in PMD. Der echte Ordnerpfad bleibt unverändert.
                            </p>

                            <label class="project-navigation-edit-label" for="@GetEditInputId(project.Id)">
                                Anzeigename
                            </label>

                            <input id="@GetEditInputId(project.Id)"
                                   class="project-navigation-edit-input"
                                   value="@ProjectEditName"
                                   @oninput="OnProjectEditNameChanged"
                                   maxlength="@MaxProjectNameLength"
                                   autocomplete="off" />

                            <div class="project-navigation-color-section">
                                <div class="project-navigation-color-title">
                                    Farbe
                                </div>

                                <div class="project-navigation-color-options" role="radiogroup" aria-label="Projektfarbe auswählen">
                                    @foreach (ProjectAccentColorOption option in AccentColorOptions)
                                    {
                                        <button class="@GetColorOptionCssClassInstance(option.Key)"
                                                type="button"
                                                role="radio"
                                                aria-checked="@IsSelectedAccentColor(option.Key)"
                                                title="@option.Label"
                                                @onclick="() => SelectProjectAccentColor(option.Key)">
                                            <span class="@GetColorPreviewCssClass(option.Key)" aria-hidden="true"></span>
                                            <span>@option.Label</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(EditErrorMessage))
                            {
                                <div class="project-navigation-edit-error">
                                    @EditErrorMessage
                                </div>
                            }

                            <div class="project-navigation-edit-actions">
                                <button class="project-navigation-confirm-edit-button"
                                        type="button"
                                        disabled="@(!CanConfirmProjectEdit)"
                                        @onclick="ConfirmProjectEdit">
                                    Speichern
                                </button>

                                <button class="project-navigation-cancel-edit-button"
                                        type="button"
                                        @onclick="CancelProjectEdit">
                                    Abbrechen
                                </button>
                            </div>
                        </div>
                    }

                    @if (ProjectPendingRemoval?.Id == project.Id)
                    {
                        <div class="project-navigation-remove-panel">
                            <div class="project-navigation-remove-title">
                                Projekt aus PMD entfernen?
                            </div>

                            <p>
                                Das Projekt wird nur aus PMD entfernt. Der echte Ordner auf deinem Computer bleibt bestehen.
                            </p>

                            <label class="project-navigation-remove-label" for="@GetRemoveInputId(project.Id)">
                                Gib <strong>BESTÄTIGEN</strong> ein.
                            </label>

                            <input id="@GetRemoveInputId(project.Id)"
                                   class="project-navigation-remove-input"
                                   value="@RemoveConfirmationText"
                                   @oninput="OnRemoveConfirmationTextChanged"
                                   autocomplete="off" />

                            @if (!string.IsNullOrWhiteSpace(RemoveErrorMessage))
                            {
                                <div class="project-navigation-remove-error">
                                    @RemoveErrorMessage
                                </div>
                            }

                            <div class="project-navigation-remove-actions">
                                <button class="project-navigation-confirm-remove-button"
                                        type="button"
                                        disabled="@(!CanConfirmProjectRemoval)"
                                        @onclick="ConfirmProjectRemoval">
                                    Aus PMD entfernen
                                </button>

                                <button class="project-navigation-cancel-remove-button"
                                        type="button"
                                        @onclick="CancelProjectRemoval">
                                    Abbrechen
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    private const string RequiredRemoveConfirmationText = "BESTÄTIGEN";
    private const int MaxProjectNameLength = 80;

    private static readonly IReadOnlyList<ProjectAccentColorOption> AccentColorOptions =
    [
        new(ProjectAccentColors.Blue, "Blau"),
        new(ProjectAccentColors.Violet, "Violett"),
        new(ProjectAccentColors.Cyan, "Türkis"),
        new(ProjectAccentColors.Emerald, "Grün"),
        new(ProjectAccentColors.Amber, "Gold"),
        new(ProjectAccentColors.Rose, "Rot")
    ];

    private Project? ProjectPendingEdit { get; set; }

    private string ProjectEditName { get; set; } = string.Empty;

    private string ProjectEditAccentColor { get; set; } = ProjectAccentColors.Default;

    private string? EditErrorMessage { get; set; }

    private Project? ProjectPendingRemoval { get; set; }

    private string RemoveConfirmationText { get; set; } = string.Empty;

    private string? RemoveErrorMessage { get; set; }

    private bool CanConfirmProjectEdit
    {
        get
        {
            if (ProjectPendingEdit is null)
            {
                return false;
            }

            string trimmedName = ProjectEditName.Trim();
            string normalizedAccentColor = ProjectAccentColors.Normalize(ProjectEditAccentColor);
            string currentAccentColor = ProjectAccentColors.Normalize(ProjectPendingEdit.AccentColor);

            bool hasValidName =
                trimmedName.Length > 0 &&
                trimmedName.Length <= MaxProjectNameLength;

            bool hasChangedName = !string.Equals(
                trimmedName,
                ProjectPendingEdit.Name,
                StringComparison.Ordinal);

            bool hasChangedColor = !string.Equals(
                normalizedAccentColor,
                currentAccentColor,
                StringComparison.Ordinal);

            return hasValidName && (hasChangedName || hasChangedColor);
        }
    }

    private bool CanConfirmProjectRemoval =>
        string.Equals(
            RemoveConfirmationText,
            RequiredRemoveConfirmationText,
            StringComparison.Ordinal);

    protected override void OnInitialized()
    {
        ProjectMemoryStore.ProjectsChanged += OnProjectsChanged;
    }

    private void StartProjectEdit(Project project)
    {
        ProjectPendingEdit = project;
        ProjectEditName = project.Name;
        ProjectEditAccentColor = ProjectAccentColors.Normalize(project.AccentColor);
        EditErrorMessage = null;

        ProjectPendingRemoval = null;
        RemoveConfirmationText = string.Empty;
        RemoveErrorMessage = null;
    }

    private void OnProjectEditNameChanged(ChangeEventArgs eventArgs)
    {
        ProjectEditName = eventArgs.Value?.ToString() ?? string.Empty;
        EditErrorMessage = null;
    }

    private void SelectProjectAccentColor(string accentColor)
    {
        ProjectEditAccentColor = ProjectAccentColors.Normalize(accentColor);
        EditErrorMessage = null;
    }

    private void ConfirmProjectEdit()
    {
        if (ProjectPendingEdit is null)
        {
            return;
        }

        string trimmedName = ProjectEditName.Trim();
        string normalizedAccentColor = ProjectAccentColors.Normalize(ProjectEditAccentColor);

        if (trimmedName.Length == 0)
        {
            EditErrorMessage = "Bitte gib einen Namen ein.";
            return;
        }

        if (trimmedName.Length > MaxProjectNameLength)
        {
            EditErrorMessage = $"Der Name darf maximal {MaxProjectNameLength} Zeichen lang sein.";
            return;
        }

        try
        {
            bool nameChanged = !string.Equals(
                trimmedName,
                ProjectPendingEdit.Name,
                StringComparison.Ordinal);

            bool colorChanged = !string.Equals(
                normalizedAccentColor,
                ProjectAccentColors.Normalize(ProjectPendingEdit.AccentColor),
                StringComparison.Ordinal);

            if (nameChanged)
            {
                bool wasRenamed = ProjectMemoryStore.RenameProject(
                    ProjectPendingEdit.Id,
                    trimmedName);

                if (!wasRenamed)
                {
                    EditErrorMessage = "Das Projekt wurde nicht gefunden.";
                    return;
                }
            }

            if (colorChanged)
            {
                bool colorWasChanged = ProjectMemoryStore.ChangeProjectAccentColor(
                    ProjectPendingEdit.Id,
                    normalizedAccentColor);

                if (!colorWasChanged)
                {
                    EditErrorMessage = "Die Farbe konnte nicht gespeichert werden.";
                    return;
                }
            }

            CancelProjectEdit();
        }
        catch (Exception ex)
        {
            EditErrorMessage = $"Das Projekt konnte nicht gespeichert werden: {ex.Message}";
        }
    }

    private void CancelProjectEdit()
    {
        ProjectPendingEdit = null;
        ProjectEditName = string.Empty;
        ProjectEditAccentColor = ProjectAccentColors.Default;
        EditErrorMessage = null;
    }

    private void StartProjectRemoval(Project project)
    {
        ProjectPendingRemoval = project;
        RemoveConfirmationText = string.Empty;
        RemoveErrorMessage = null;

        ProjectPendingEdit = null;
        ProjectEditName = string.Empty;
        ProjectEditAccentColor = ProjectAccentColors.Default;
        EditErrorMessage = null;
    }

    private void OnRemoveConfirmationTextChanged(ChangeEventArgs eventArgs)
    {
        RemoveConfirmationText = eventArgs.Value?.ToString() ?? string.Empty;
        RemoveErrorMessage = null;
    }

    private void ConfirmProjectRemoval()
    {
        if (ProjectPendingRemoval is null || !CanConfirmProjectRemoval)
        {
            return;
        }

        Guid removedProjectId = ProjectPendingRemoval.Id;

        try
        {
            bool wasRemoved = ProjectMemoryStore.RemoveProject(removedProjectId);

            if (!wasRemoved)
            {
                RemoveErrorMessage = "Das Projekt wurde nicht gefunden.";
                return;
            }

            CancelProjectRemoval();

            if (IsCurrentProjectRoute(removedProjectId))
            {
                NavigationManager.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            RemoveErrorMessage = $"Das Projekt konnte nicht entfernt werden: {ex.Message}";
        }
    }

    private void CancelProjectRemoval()
    {
        ProjectPendingRemoval = null;
        RemoveConfirmationText = string.Empty;
        RemoveErrorMessage = null;
    }

    private bool IsCurrentProjectRoute(Guid projectId)
    {
        string relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        return relativePath.StartsWith(
            $"projekte/{projectId}",
            StringComparison.OrdinalIgnoreCase);
    }

    private static string GetProjectCardCssClass(Project project)
    {
        string accentColor = ProjectAccentColors.Normalize(project.AccentColor);

        return $"project-navigation-card project-navigation-accent-{accentColor}";
    }

    private static string GetProjectMarkerCssClass(Project project)
    {
        string accentColor = ProjectAccentColors.Normalize(project.AccentColor);

        return $"project-navigation-marker project-navigation-marker-{accentColor}";
    }


    private string GetColorOptionCssClassInstance(string accentColor)
    {
        string selectedClass = IsSelectedAccentColor(accentColor)
            ? " is-selected"
            : string.Empty;

        return $"project-navigation-color-option project-navigation-color-option-{accentColor}{selectedClass}";
    }


    private string GetColorPreviewCssClass(string accentColor)
    {
        return $"project-navigation-color-preview project-navigation-color-preview-{ProjectAccentColors.Normalize(accentColor)}";
    }

    private bool IsSelectedAccentColor(string accentColor)
    {
        return string.Equals(
            ProjectAccentColors.Normalize(ProjectEditAccentColor),
            ProjectAccentColors.Normalize(accentColor),
            StringComparison.Ordinal);
    }

    private static string GetEditInputId(Guid projectId)
    {
        return $"project-edit-name-{projectId}";
    }

    private static string GetRemoveInputId(Guid projectId)
    {
        return $"project-remove-confirmation-{projectId}";
    }

    private void OnProjectsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string GetProjectInitials(string projectName)
    {
        if (string.IsNullOrWhiteSpace(projectName))
        {
            return "P";
        }

        string[] parts = projectName.Split(
            new[] { '_', '-', ' ' },
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (parts.Length == 0)
        {
            return projectName[..1].ToUpperInvariant();
        }

        if (parts.Length == 1)
        {
            return parts[0][..1].ToUpperInvariant();
        }

        return string.Concat(parts[0][..1], parts[1][..1]).ToUpperInvariant();
    }

    private static string FormatNavigationDate(DateTime dateTime)
    {
        return dateTime.ToString("dd.MM. HH:mm");
    }

    public void Dispose()
    {
        ProjectMemoryStore.ProjectsChanged -= OnProjectsChanged;
    }

    private sealed record ProjectAccentColorOption(string Key, string Label);
}