@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectFiles
@using System.Net
@using System.Text

@if (PreviewResult is not null)
{
    <div class="border rounded overflow-hidden shadow-sm pmd-preview-card">
        <div class="border-bottom p-3 pmd-preview-header">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                <div>
                    <div class="fw-semibold">
                        @PreviewResult.Message
                    </div>

                    @if (PreviewResult.CanShowContent)
                    {
                        <div class="text-muted small mt-1">
                            @PreviewResult.LineCount Zeilen
                            · @ProjectOverviewFormatter.FormatFileSize(PreviewResult.SizeInBytes)

                            @if (PreviewResult.WasTruncated)
                            {
                                <span>· gekürzt</span>
                            }
                        </div>
                    }
                </div>

                <span class="@PreviewBadgeCssClass">
                    @PreviewStatusText
                </span>
            </div>
        </div>

        @if (PreviewResult.CanShowContent)
        {
            <div class="pmd-code-preview">
                <pre class="mb-0 px-4 py-3 pmd-code-block"><code class="pmd-code-content">@HighlightedPreviewContent</code></pre>
            </div>
        }
    </div>
}


@code {
    [Parameter]
    public ProjectFileContentResult? PreviewResult { get; set; }

    private static readonly HashSet<char> HighlightedCodeSymbols = new()
    {
        '(', ')',
        '{', '}',
        '[', ']',
        '<', '>',
        '=',
        '/',
        '\\',
        '.',
        ',',
        ';',
        ':',
        '"',
        '\'',
        '`',
        '+',
        '-',
        '*',
        '&',
        '|',
        '!',
        '?'
    };

    private MarkupString HighlightedPreviewContent =>
        new(RenderHighlightedContent(PreviewResult?.Content));

    private string PreviewStatusText =>
        PreviewResult?.CanShowContent == true
            ? "Vorschau bereit"
            : "Nicht verfügbar";

    private string PreviewBadgeCssClass =>
        PreviewResult?.CanShowContent == true
            ? "badge bg-success-subtle text-success border align-self-start"
            : "badge bg-warning-subtle text-warning border align-self-start";

    private static string RenderHighlightedContent(string? content)
    {
        if (string.IsNullOrEmpty(content))
        {
            return string.Empty;
        }

        StringBuilder builder = new();

        foreach (char character in content)
        {
            string encodedCharacter = WebUtility.HtmlEncode(character.ToString());

            if (HighlightedCodeSymbols.Contains(character))
            {
                builder
                    .Append("<span class=\"pmd-code-symbol\">")
                    .Append(encodedCharacter)
                    .Append("</span>");

                continue;
            }

            builder.Append(encodedCharacter);
        }

        return builder.ToString();
    }
}