@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectStates
@using System.Linq

@if (TotalFileCount == 0)
{
    <p class="text-muted mb-0">
        In der letzten Prüfung wurden keine Dateien gespeichert.
    </p>
}
else if (FilteredFiles.Count == 0)
{
    <div class="alert alert-info mb-0">
        Für diese Suche wurden keine Dateien gefunden.
    </div>
}
else
{
    <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-3">
        <div class="text-muted small">
            @FilteredFiles.Count Treffer · sortiert nach @SelectedSortLabel
        </div>

        @if (FilteredFiles.Count > CurrentVisibleCount)
        {
            <div class="text-muted small">
                @CurrentVisibleCount von @FilteredFiles.Count sichtbar
            </div>
        }
    </div>

    <div class="d-flex flex-column gap-2">
        @foreach (ProjectStateFile file in VisibleFiles)
        {
            <div class="@GetFileCardCssClass(file)">
                <div class="pmd-list-item-row">
                    <div class="pmd-list-item-text">
                        <code class="pmd-truncated-path"
                              title="@file.RelativePath">
                            @file.RelativePath
                        </code>

                        <div class="text-muted small mt-1">
                            @ProjectOverviewFormatter.FormatExtension(file.Extension)
                            · @ProjectOverviewFormatter.FormatFileSize(file.SizeInBytes)
                            · geändert @ProjectOverviewFormatter.FormatDateTime(file.LastChangedAt)
                        </div>
                    </div>

                    <div class="pmd-list-item-actions">
                        <button class="btn btn-sm btn-outline-primary"
                                type="button"
                                @onclick="() => OnSelectFile.InvokeAsync(file)">
                            Details
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <ProgressiveListControls TotalCount="@FilteredFiles.Count"
                             VisibleCount="@CurrentVisibleCount"
                             InitialCount="@InitialVisibleFileCount"
                             StepCount="@VisibleFileStepCount"
                             ItemLabel="Dateien"
                             OnShowMore="ShowMore"
                             OnShowAll="ShowAll"
                             OnCollapse="Collapse" />
}

@code {
    private const int InitialVisibleFileCount = 8;
    private const int VisibleFileStepCount = 8;

    private int visibleFileCount = InitialVisibleFileCount;
    private string lastResetKey = string.Empty;

    [Parameter]
    public int TotalFileCount { get; set; }

    [Parameter]
    public IReadOnlyList<ProjectStateFile> FilteredFiles { get; set; } =
        Array.Empty<ProjectStateFile>();

    [Parameter]
    public IReadOnlyList<ProjectStateFile> VisibleFilesSource { get; set; } =
        Array.Empty<ProjectStateFile>();

    [Parameter]
    public ProjectStateFile? SelectedFile { get; set; }

    [Parameter]
    public string SelectedSortLabel { get; set; } = "Pfad";

    [Parameter]
    public string ResetKey { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<ProjectStateFile> OnSelectFile { get; set; }

    private int CurrentVisibleCount => Math.Min(
        visibleFileCount,
        VisibleFilesSource.Count);

    private IReadOnlyList<ProjectStateFile> VisibleFiles =>
        VisibleFilesSource
            .Take(CurrentVisibleCount)
            .ToList();

    protected override void OnParametersSet()
    {
        if (!string.Equals(lastResetKey, ResetKey, StringComparison.Ordinal))
        {
            visibleFileCount = InitialVisibleFileCount;
            lastResetKey = ResetKey;
        }

        if (VisibleFilesSource.Count < visibleFileCount)
        {
            visibleFileCount = Math.Max(
                InitialVisibleFileCount,
                VisibleFilesSource.Count);
        }
    }

    private void ShowMore()
    {
        visibleFileCount = Math.Min(
            VisibleFilesSource.Count,
            visibleFileCount + VisibleFileStepCount);
    }

    private void ShowAll()
    {
        visibleFileCount = VisibleFilesSource.Count;
    }

    private void Collapse()
    {
        visibleFileCount = InitialVisibleFileCount;
    }

    private string GetFileCardCssClass(ProjectStateFile file)
    {
        bool isSelected = IsSameFile(file, SelectedFile);

        return isSelected
            ? "pmd-list-card border border-primary rounded p-3 bg-light"
            : "pmd-list-card border rounded p-3";
    }

    private static bool IsSameFile(
        ProjectStateFile firstFile,
        ProjectStateFile? secondFile)
    {
        if (secondFile is null)
        {
            return false;
        }

        return string.Equals(
                firstFile.RelativePath,
                secondFile.RelativePath,
                StringComparison.OrdinalIgnoreCase) &&
            firstFile.LastChangedAt == secondFile.LastChangedAt &&
            firstFile.SizeInBytes == secondFile.SizeInBytes;
    }
}
