@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.Projects

@if (Project is not null)
{
    <div class="card mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0">Projektinformationen</h2>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Angelegt am</div>
                        <div>@ProjectOverviewFormatter.FormatDateTime(Project.CreatedAt)</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Zuletzt geprüft am</div>
                        <div>@ProjectOverviewFormatter.FormatDateTime(Project.LastScannedAt)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Project? Project { get; set; }
}
