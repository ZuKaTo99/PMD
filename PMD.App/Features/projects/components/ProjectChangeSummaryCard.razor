@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectStates

<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
            <div>
                <h2 class="h5 mb-1">Änderungen seit letzter Prüfung</h2>
                <div class="text-muted small">
                    PMD wertet die letzten beiden Prüfungen automatisch aus.
                </div>
            </div>

            @if (ChangeSummary is not null)
            {
                <span class="badge bg-secondary align-self-start align-self-lg-center">
                    Automatisch vorbereitet
                </span>
            }
        </div>
    </div>

    <div class="card-body">
        @if (LatestProjectState is null)
        {
            <p class="text-muted mb-0">
                Nach der ersten Prüfung kann PMD den aktuellen Projektzustand anzeigen.
            </p>
        }
        else if (PreviousProjectState is null || ChangeSummary is null)
        {
            <div class="alert alert-info mb-0">
                Für eine Änderungsauswertung braucht PMD noch eine zweite Prüfung dieses Projekts.
                Prüfe das Projekt später erneut, dann werden die Veränderungen hier zusammengefasst.
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Neu</div>
                        <div class="fs-4 fw-semibold">@ChangeSummary.NewFileCount</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Geändert</div>
                        <div class="fs-4 fw-semibold">@ChangeSummary.ChangedFileCount</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Entfernt</div>
                        <div class="fs-4 fw-semibold">@ChangeSummary.DeletedFileCount</div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Unverändert</div>
                        <div class="fs-4 fw-semibold">@ChangeSummary.UnchangedFileCount</div>
                    </div>
                </div>
            </div>

            @if (ChangeSummary.NewFileCount == 0
                && ChangeSummary.ChangedFileCount == 0
                && ChangeSummary.DeletedFileCount == 0)
            {
                <div class="alert alert-success mt-3 mb-0">
                    Seit der vorherigen Prüfung wurden keine Änderungen erkannt.
                </div>
            }
            else
            {
                <div class="alert alert-light border mt-3 mb-0">
                    Die Detailansicht für Änderungen wird später als eigener Bereich aufgebaut,
                    damit die Projektseite übersichtlich bleibt.
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public ProjectState? LatestProjectState { get; set; }

    [Parameter]
    public ProjectState? PreviousProjectState { get; set; }

    [Parameter]
    public ProjectStateComparisonResult? ChangeSummary { get; set; }
}
