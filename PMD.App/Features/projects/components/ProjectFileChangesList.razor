@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectChanges
@using System.Linq

@if (ChangesResult is not null)
{
    <div class="card mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0">@ListTitle</h2>
        </div>

        <div class="card-body">
            @if (VisibleChanges.Count == 0)
            {
                <div class="alert alert-success mb-0">
                    @EmptyText
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (ProjectFileChange change in VisibleChanges)
                    {
                        <div class="@GetChangeCardCssClass(change)">
                            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                                <div class="min-w-0">
                                    <div class="text-truncate">
                                        <code>@change.RelativePath</code>
                                    </div>

                                    <div class="text-muted small mt-1">
                                        @ProjectOverviewFormatter.FormatExtension(change.Extension)
                                    </div>
                                </div>

                                <div class="d-flex gap-2 align-items-start align-self-lg-start">
                                    <span class="badge bg-light text-dark border">
                                        @FormatChangeKind(change.ChangeKind)
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            @onclick="() => OnSelectChange.InvokeAsync(change)">
                                        Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (TotalVisibleChangeCount > VisibleChanges.Count)
                {
                    <div class="alert alert-secondary mt-3 mb-0">
                        Es werden die ersten @VisibleChanges.Count von @TotalVisibleChangeCount passenden Dateien angezeigt.
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private const int MaxVisibleChangeCount = 25;

    [Parameter]
    public ProjectChangesResult? ChangesResult { get; set; }

    [Parameter]
    public ProjectFileChangeKind? SelectedChangeKind { get; set; }

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public ProjectFileChange? SelectedChange { get; set; }

    [Parameter]
    public EventCallback<ProjectFileChange> OnSelectChange { get; set; }

    private IReadOnlyList<ProjectFileChange> VisibleChanges =>
        GetFilteredChanges()
            .Take(MaxVisibleChangeCount)
            .ToList();

    private int TotalVisibleChangeCount =>
        GetFilteredChanges().Count();

    private string ListTitle
    {
        get
        {
            return SelectedChangeKind switch
            {
                ProjectFileChangeKind.Added => "Neue Dateien",
                ProjectFileChangeKind.Modified => "Geänderte Dateien",
                ProjectFileChangeKind.Removed => "Entfernte Dateien",
                ProjectFileChangeKind.Unchanged => "Unveränderte Dateien",
                _ => "Auffällige Änderungen"
            };
        }
    }

    private string EmptyText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                return "Für diese Suche wurden keine passenden Änderungen gefunden.";
            }

            return SelectedChangeKind switch
            {
                ProjectFileChangeKind.Added => "Zwischen den letzten beiden Prüfungen wurden keine neuen Dateien erkannt.",
                ProjectFileChangeKind.Modified => "Zwischen den letzten beiden Prüfungen wurden keine geänderten Dateien erkannt.",
                ProjectFileChangeKind.Removed => "Zwischen den letzten beiden Prüfungen wurden keine entfernten Dateien erkannt.",
                ProjectFileChangeKind.Unchanged => "Es wurden keine unveränderten Dateien gefunden.",
                _ => "Zwischen den letzten beiden Prüfungen wurden keine auffälligen Dateiänderungen erkannt."
            };
        }
    }

    private IEnumerable<ProjectFileChange> GetFilteredChanges()
    {
        if (ChangesResult is null)
        {
            return Array.Empty<ProjectFileChange>();
        }

        IEnumerable<ProjectFileChange> changes = ChangesResult.Changes;

        if (SelectedChangeKind is null)
        {
            changes = changes
                .Where(change => change.ChangeKind != ProjectFileChangeKind.Unchanged);
        }
        else
        {
            changes = changes
                .Where(change => change.ChangeKind == SelectedChangeKind);
        }

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            changes = changes.Where(change =>
                change.RelativePath.Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase) ||
                change.FileName.Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase));
        }

        return changes
            .OrderBy(change => change.RelativePath, StringComparer.OrdinalIgnoreCase);
    }

    private string GetChangeCardCssClass(ProjectFileChange change)
    {
        bool isSelected = IsSameChange(change, SelectedChange);

        return isSelected
            ? "border border-primary rounded p-3 bg-light"
            : "border rounded p-3";
    }

    private static bool IsSameChange(
        ProjectFileChange firstChange,
        ProjectFileChange? secondChange)
    {
        if (secondChange is null)
        {
            return false;
        }

        return firstChange.ChangeKind == secondChange.ChangeKind &&
            string.Equals(
                firstChange.RelativePath,
                secondChange.RelativePath,
                StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatChangeKind(ProjectFileChangeKind changeKind)
    {
        return changeKind switch
        {
            ProjectFileChangeKind.Added => "Neu",
            ProjectFileChangeKind.Modified => "Geändert",
            ProjectFileChangeKind.Removed => "Entfernt",
            ProjectFileChangeKind.Unchanged => "Unverändert",
            _ => "Unbekannt"
        };
    }
}