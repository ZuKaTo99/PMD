@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectChanges
@using System.Linq

@if (ChangesResult is not null)
{
    <div class="card mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0">@ListTitle</h2>
        </div>

        <div class="card-body">
            @if (FilteredChanges.Count == 0)
            {
                <div class="alert alert-success mb-0">
                    @EmptyText
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (ProjectFileChange change in VisibleChanges)
                    {
                        <div class="@GetChangeCardCssClass(change)">
                            <div class="pmd-list-item-row">
                                <div class="pmd-list-item-text">
                                    <code class="pmd-truncated-path"
                                          title="@change.RelativePath">
                                        @change.RelativePath
                                    </code>

                                    <div class="text-muted small mt-1">
                                        @ProjectOverviewFormatter.FormatExtension(change.Extension)
                                    </div>
                                </div>

                                <div class="pmd-list-item-actions">
                                    <span class="badge bg-light text-dark border">
                                        @FormatChangeKind(change.ChangeKind)
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            @onclick="() => OnSelectChange.InvokeAsync(change)">
                                        Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <ProgressiveListControls TotalCount="@FilteredChanges.Count"
                                         VisibleCount="@CurrentVisibleCount"
                                         InitialCount="@InitialVisibleChangeCount"
                                         StepCount="@VisibleChangeStepCount"
                                         ItemLabel="Dateien"
                                         OnShowMore="ShowMore"
                                         OnShowAll="ShowAll"
                                         OnCollapse="Collapse" />
            }
        </div>
    </div>
}

@code {
    private const int InitialVisibleChangeCount = 8;
    private const int VisibleChangeStepCount = 8;

    private int visibleChangeCount = InitialVisibleChangeCount;
    private string lastResetKey = string.Empty;
    private ProjectChangesResult? lastChangesResult;

    [Parameter]
    public ProjectChangesResult? ChangesResult { get; set; }

    [Parameter]
    public ProjectFileChangeKind? SelectedChangeKind { get; set; }

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public ProjectFileChange? SelectedChange { get; set; }

    [Parameter]
    public EventCallback<ProjectFileChange> OnSelectChange { get; set; }

    private IReadOnlyList<ProjectFileChange> FilteredChanges =>
        GetFilteredChanges().ToList();

    private int CurrentVisibleCount => Math.Min(
        visibleChangeCount,
        FilteredChanges.Count);

    private IReadOnlyList<ProjectFileChange> VisibleChanges =>
        FilteredChanges
            .Take(CurrentVisibleCount)
            .ToList();

    private string ResetKey =>
        $"{SelectedChangeKind?.ToString() ?? "all"}\u001f{SearchText}";

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(lastChangesResult, ChangesResult) ||
            !string.Equals(lastResetKey, ResetKey, StringComparison.Ordinal))
        {
            visibleChangeCount = InitialVisibleChangeCount;
            lastResetKey = ResetKey;
            lastChangesResult = ChangesResult;
        }

        if (FilteredChanges.Count < visibleChangeCount)
        {
            visibleChangeCount = Math.Max(
                InitialVisibleChangeCount,
                FilteredChanges.Count);
        }
    }

    private void ShowMore()
    {
        visibleChangeCount = Math.Min(
            FilteredChanges.Count,
            visibleChangeCount + VisibleChangeStepCount);
    }

    private void ShowAll()
    {
        visibleChangeCount = FilteredChanges.Count;
    }

    private void Collapse()
    {
        visibleChangeCount = InitialVisibleChangeCount;
    }

    private string ListTitle
    {
        get
        {
            return SelectedChangeKind switch
            {
                ProjectFileChangeKind.Added => "Neue Dateien",
                ProjectFileChangeKind.Modified => "Geänderte Dateien",
                ProjectFileChangeKind.Removed => "Entfernte Dateien",
                ProjectFileChangeKind.Unchanged => "Unveränderte Dateien",
                _ => "Auffällige Änderungen"
            };
        }
    }

    private string EmptyText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                return "Für diese Suche wurden keine passenden Änderungen gefunden.";
            }

            return SelectedChangeKind switch
            {
                ProjectFileChangeKind.Added => "Zwischen den verglichenen Prüfungen wurden keine neuen Dateien erkannt.",
                ProjectFileChangeKind.Modified => "Zwischen den verglichenen Prüfungen wurden keine geänderten Dateien erkannt.",
                ProjectFileChangeKind.Removed => "Zwischen den verglichenen Prüfungen wurden keine entfernten Dateien erkannt.",
                ProjectFileChangeKind.Unchanged => "Es wurden keine unveränderten Dateien gefunden.",
                _ => "Zwischen den verglichenen Prüfungen wurden keine auffälligen Dateiänderungen erkannt."
            };
        }
    }

    private IEnumerable<ProjectFileChange> GetFilteredChanges()
    {
        if (ChangesResult is null)
        {
            return Array.Empty<ProjectFileChange>();
        }

        IEnumerable<ProjectFileChange> changes = ChangesResult.Changes;

        if (SelectedChangeKind is null)
        {
            changes = changes
                .Where(change => change.ChangeKind != ProjectFileChangeKind.Unchanged);
        }
        else
        {
            changes = changes
                .Where(change => change.ChangeKind == SelectedChangeKind);
        }

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            changes = changes.Where(change =>
                change.RelativePath.Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase) ||
                change.FileName.Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase));
        }

        return changes
            .OrderBy(change => change.RelativePath, StringComparer.OrdinalIgnoreCase);
    }

    private string GetChangeCardCssClass(ProjectFileChange change)
    {
        bool isSelected = IsSameChange(change, SelectedChange);

        return isSelected
            ? "pmd-list-card pmd-card border border-primary rounded p-3 bg-light"
            : "pmd-list-card pmd-card border rounded p-3";
    }

    private static bool IsSameChange(
        ProjectFileChange firstChange,
        ProjectFileChange? secondChange)
    {
        if (secondChange is null)
        {
            return false;
        }

        return firstChange.ChangeKind == secondChange.ChangeKind &&
            string.Equals(
                firstChange.RelativePath,
                secondChange.RelativePath,
                StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatChangeKind(ProjectFileChangeKind changeKind)
    {
        return changeKind switch
        {
            ProjectFileChangeKind.Added => "Neu",
            ProjectFileChangeKind.Modified => "Geändert",
            ProjectFileChangeKind.Removed => "Entfernt",
            ProjectFileChangeKind.Unchanged => "Unverändert",
            _ => "Unbekannt"
        };
    }
}
