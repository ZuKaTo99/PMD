@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectStates

<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
            <div>
                <h2 class="h5 mb-1">Projektverlauf</h2>
                <div class="text-muted small">
                    Gespeicherte Prüfungen dieses Projekts aus der SQLite-Datenbank.
                </div>
            </div>

            @if (ProjectStates.Count > 0)
            {
                <span class="badge bg-secondary align-self-start align-self-lg-center">
                    @ProjectStates.Count Prüfungen
                </span>
            }
        </div>
    </div>

    <div class="card-body">
        @if (ProjectStates.Count == 0)
        {
            <div class="alert alert-info mb-0">
                Für dieses Projekt wurde noch keine Prüfung gespeichert.
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @for (var index = 0; index < ProjectStates.Count; index++)
                {
                    ProjectState projectState = ProjectStates[index];
                    int projectStateNumber = ProjectStates.Count - index;

                    <div class="border rounded p-3">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                            <div>
                                <div class="fw-semibold">Prüfung @projectStateNumber</div>
                                <div class="text-muted small">
                                    Geprüft am @ProjectOverviewFormatter.FormatDateTime(projectState.ScannedAt)
                                </div>
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <span class="badge bg-light text-dark border">
                                    @projectState.FileCount Dateien
                                </span>
                                <span class="badge bg-light text-dark border">
                                    @ProjectOverviewFormatter.FormatFileSize(projectState.TotalSizeInBytes)
                                </span>
                            </div>
                        </div>

                        <div class="row g-3 mt-2">
                            <div class="col-md-4">
                                <div class="text-muted small">Prüfdauer</div>
                                <div>@ProjectOverviewFormatter.FormatDuration(projectState.ScanDuration)</div>
                            </div>

                            <div class="col-md-4">
                                <div class="text-muted small">Hinweise</div>
                                <div>@projectState.WarningCount</div>
                            </div>

                            <div class="col-md-4">
                                <div class="text-muted small">Übersprungene Ordner</div>
                                <div>@projectState.IgnoredFolderCount</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<ProjectState> ProjectStates { get; set; } = Array.Empty<ProjectState>();
}