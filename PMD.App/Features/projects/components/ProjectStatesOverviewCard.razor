@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectStates
@using PMD.App.Features.Scanner.Components

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Projektverlauf dieses Projekts</h2>
    </div>

    <div class="card-body">
        @if (ProjectStates.Count == 0)
        {
            <div class="alert alert-info mb-0">
                Für dieses Projekt wurde in dieser Sitzung noch keine Prüfung gespeichert.
            </div>
        }
        else
        {
            <p class="text-muted">
                Diese Projektstände sind aktuell nur für diese laufende Sitzung gemerkt.
            </p>

            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Prüfung</th>
                            <th>Erstellt am</th>
                            <th>Dateien</th>
                            <th>Größe</th>
                            <th>Dauer</th>
                            <th>Hinweise</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < ProjectStates.Count; index++)
                        {
                            ProjectState projectState = ProjectStates[index];
                            int projectStateNumber = ProjectStates.Count - index;

                            <tr>
                                <td>Prüfung @projectStateNumber</td>
                                <td>@projectState.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>@projectState.FileCount</td>
                                <td>@ScannerDisplayFormatter.FormatFileSize(projectState.TotalSizeInBytes)</td>
                                <td>@ScannerDisplayFormatter.FormatScanDuration(projectState.ScanDuration)</td>
                                <td>@projectState.WarningCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<ProjectState> ProjectStates { get; set; } = Array.Empty<ProjectState>();
}