@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectStates
@using System.Linq

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Dateien</h2>
    </div>

    <div class="card-body">
        @if (ProjectState is null || ProjectState.Files.Count == 0)
        {
            <p class="text-muted mb-0">Noch keine Dateien verfügbar.</p>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var file in ProjectState.Files.OrderBy(file => file.RelativePath).Take(10))
                {
                    <div class="border rounded p-2">
                        <div class="text-truncate"><code>@file.RelativePath</code></div>
                        <div class="text-muted small">
                            @ProjectOverviewFormatter.FormatExtension(file.Extension) · @ProjectOverviewFormatter.FormatFileSize(file.SizeInBytes) · @ProjectOverviewFormatter.FormatDateTime(file.LastChangedAt)
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public ProjectState? ProjectState { get; set; }
}
