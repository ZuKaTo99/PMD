@namespace PMD.App.Features.Projects.Components
@using Microsoft.AspNetCore.Components
@using PMD.App.Domain.ProjectStates

<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
            <div>
                <h2 class="h5 mb-1">Aktueller Projektstatus</h2>
                <div class="text-muted small">
                    Die wichtigsten Informationen aus der letzten Prüfung.
                </div>
            </div>

            @if (ProjectState is not null)
            {
                <span class="badge bg-success align-self-start align-self-lg-center">
                    Geprüft
                </span>
            }
        </div>
    </div>

    <div class="card-body">
        @if (ProjectState is null)
        {
            <p class="text-muted mb-0">
                Für dieses Projekt wurde noch keine Prüfung gespeichert.
            </p>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Zuletzt geprüft</div>
                        <div class="fw-semibold">
                            @ProjectOverviewFormatter.FormatDateTime(ProjectState.ScannedAt)
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Dateien erkannt</div>
                        <div class="fw-semibold">@ProjectState.FileCount</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Projektgröße</div>
                        <div class="fw-semibold">
                            @ProjectOverviewFormatter.FormatFileSize(ProjectState.TotalSizeInBytes)
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Hinweise</div>
                        <div class="fw-semibold">@ProjectState.WarningCount</div>
                    </div>
                </div>
            </div>

            <div class="alert alert-light border mt-3 mb-0">
                Diese Prüfung ist im Projektverlauf gespeichert und kann später für Änderungen,
                Dateien, Code-Ansicht und KI-Auswertung genutzt werden.
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public ProjectState? ProjectState { get; set; }
}
