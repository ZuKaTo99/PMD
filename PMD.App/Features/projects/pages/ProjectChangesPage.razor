@page "/projekte/{ProjectId:guid}/aenderungen"
@namespace PMD.App.Features.Projects.Pages
@using PMD.App.Domain.ProjectChanges
@using PMD.App.Features.Projects.Components

<PageTitle>PMD - Änderungen</PageTitle>

<div class="container-fluid pmd-project-page">
    @if (CurrentProject is null)
    {
        <div class="alert alert-warning">
            Das Projekt wurde nicht gefunden. Es ist nicht mehr in der Projektliste vorhanden.
        </div>
    }
    else
    {
        <div class="mb-4">
            <div class="text-muted small mb-1">PMD - Änderungen</div>

            <div class="d-flex flex-column flex-xl-row justify-content-between gap-3">
                <div>
                    <h1>Änderungen</h1>
                    <p class="text-muted mb-0">
                        Änderungsansicht für @CurrentProject.Name. Dieser Bereich wird aus dem gespeicherten Projektverlauf aufgebaut.
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap align-self-xl-start">
                    <a class="btn btn-outline-secondary" href="@($"/projekte/{CurrentProject.Id}")">
                        Zurück zum Projekt
                    </a>

                    <a class="btn btn-outline-primary" href="@($"/projekte/{CurrentProject.Id}/dateien")">
                        Dateien ansehen
                    </a>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0">Grundlage</h2>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    PMD vergleicht die letzte gespeicherte Prüfung mit der vorherigen Prüfung dieses Projekts.
                </p>

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Geladene Prüfungen</div>
                            <div class="fw-semibold">@ProjectStates.Count</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Letzte Prüfung</div>
                            <div class="fw-semibold">
                                @FormatProjectStateDate(LatestProjectState)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Vorherige Prüfung</div>
                            <div class="fw-semibold">
                                @FormatProjectStateDate(PreviousProjectState)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (ProjectStates.Count == 0)
        {
            <div class="alert alert-info">
                Für dieses Projekt gibt es noch keine gespeicherte Prüfung. Prüfe das Projekt zuerst, damit PMD später Änderungen erkennen kann.
            </div>
        }
        else if (ProjectStates.Count == 1)
        {
            <div class="alert alert-info">
                Für eine Änderungsanalyse braucht PMD mindestens zwei gespeicherte Prüfungen. Prüfe das Projekt später erneut, nachdem sich Dateien geändert haben.
            </div>
        }
        else if (ChangesResult is not null)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Änderungsübersicht</h2>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        Erste Auswertung auf Basis von Dateipfad, Dateigröße und Änderungsdatum.
                    </p>

                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Neue Dateien</div>
                                <div class="display-6">@ChangesResult.AddedFileCount</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Geänderte Dateien</div>
                                <div class="display-6">@ChangesResult.ModifiedFileCount</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Entfernte Dateien</div>
                                <div class="display-6">@ChangesResult.RemovedFileCount</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Unveränderte Dateien</div>
                                <div class="display-6">@ChangesResult.UnchangedFileCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Auffällige Änderungen</h2>
                </div>

                <div class="card-body">
                    @{
                        IReadOnlyList<ProjectFileChange> visibleChanges = ChangesResult.Changes
                            .Where(change => change.ChangeKind != ProjectFileChangeKind.Unchanged)
                            .Take(25)
                            .ToList();
                    }

                    @if (visibleChanges.Count == 0)
                    {
                        <div class="alert alert-success mb-0">
                            Zwischen den letzten beiden Prüfungen wurden keine auffälligen Dateiänderungen erkannt.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (ProjectFileChange change in visibleChanges)
                            {
                                <div class="border rounded p-3">
                                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                                        <div class="min-w-0">
                                            <div class="text-truncate">
                                                <code>@change.RelativePath</code>
                                            </div>

                                            <div class="text-muted small mt-1">
                                                @ProjectOverviewFormatter.FormatExtension(change.Extension)
                                            </div>
                                        </div>

                                        <span class="badge bg-light text-dark border align-self-start">
                                            @FormatChangeKind(change.ChangeKind)
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (ChangesResult.Changes.Count(change => change.ChangeKind != ProjectFileChangeKind.Unchanged) > visibleChanges.Count)
                        {
                            <div class="alert alert-secondary mt-3 mb-0">
                                Es werden die ersten @visibleChanges.Count auffälligen Änderungen angezeigt.
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>