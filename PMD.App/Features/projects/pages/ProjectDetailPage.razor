@page "/projekte/{ProjectId:guid}"
@namespace PMD.App.Features.Projects.Pages
@using PMD.App.Features.Projects.Components
@using PMD.App.Features.Scanner.Components

<PageTitle>PMD - Projekt</PageTitle>

<div class="container-fluid pmd-project-page"
     aria-busy="@isScanOperationActive">

    @if (CurrentProject is null)
    {
        <div class="alert alert-warning">
            Das Projekt wurde nicht gefunden. Es ist nicht mehr in der Projektliste vorhanden.
        </div>
    }
    else
    {
        <div class="mb-4">
            <div class="text-muted small mb-1">
                PMD - Projekt
            </div>

            <div class="d-flex flex-column flex-xl-row justify-content-between gap-3">
                <div>
                    <h1>@CurrentProject.Name</h1>

                    <p class="text-muted mb-0">
                        Projektzentrale mit Status, Verlauf, Projektinhalt,
                        Dateien und Änderungen.
                    </p>

                    <div class="project-folder-location mt-3">
                        <span class="project-folder-location-label">
                            Projektordner
                        </span>

                        <code title="@CurrentProject.RootPath">
                            @CurrentProject.RootPath
                        </code>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap align-self-xl-start">
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@isScanOperationActive"
                            @onclick="ScanCurrentProjectAsync">

                        @if (isScanOperationActive)
                        {
                            <span class="spinner-border spinner-border-sm me-2"
                                  role="status"
                                  aria-hidden="true">
                            </span>

                            <span>Prüfung läuft</span>
                        }
                        else
                        {
                            <span>Projekt erneut prüfen</span>
                        }
                    </button>

                    <button type="button"
                            class="btn btn-outline-primary"
                            title="Projektordner im Windows-Explorer öffnen"
                            @onclick="OpenCurrentProjectFolder">
                        Projektordner öffnen
                    </button>

                    <a class="btn btn-outline-primary"
                       href="@($"/projekte/{CurrentProject.Id}/dateien")">
                        Dateien ansehen
                    </a>

                    <a class="btn btn-outline-primary"
                       href="@($"/projekte/{CurrentProject.Id}/aenderungen")">
                        Änderungen ansehen
                    </a>

                    <a class="btn btn-outline-secondary"
                       href="/projektpruefung">
                        Anderen Projektordner prüfen
                    </a>
                </div>
            </div>
        </div>

        @if (isScanOperationActive)
        {
            <ProjectScanProgressCard StatusText="@scanStatusText"
                                     Progress="@scanProgress"
                                     CanCancel="@CanCancelScan"
                                     OnCancel="CancelScan" />
        }

        @if (!string.IsNullOrWhiteSpace(InfoMessage))
        {
            <div class="alert alert-success">
                @InfoMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        <LatestProjectCheckSummaryCard ProjectState="@LatestProjectState" />

        <ProjectChangeSummaryCard LatestProjectState="@LatestProjectState"
                                  PreviousProjectState="@PreviousProjectState"
                                  ChangeSummary="@ChangesSinceLastCheck" />

        <ProjectAnalysisSummaryCard Overview="@CurrentOverview" />

        <ProjectStatesOverviewCard ProjectStates="@CurrentProjectStates" />

        <ProjectInformationCard Project="@CurrentProject" />
    }
</div>