@page "/projekte/{ProjectId:guid}"
@namespace PMD.App.Features.Projects.Pages
@using PMD.App.Features.Projects.Components

<PageTitle>PMD - Projekt</PageTitle>

<div class="container-fluid pmd-project-page">
    @if (CurrentProject is null)
    {
        <div class="alert alert-warning">
            Das Projekt wurde nicht gefunden. Es ist aktuell nur für diese laufende Sitzung verfügbar.
        </div>
    }
    else
    {
        <div class="mb-4">
            <div class="text-muted small mb-1">PMD - Projekt</div>
            <div class="d-flex flex-column flex-xl-row justify-content-between gap-3">
                <div>
                    <h1>@CurrentProject.Name</h1>
                    <p class="text-muted mb-0">
                        Projektzentrale mit aktuellem Status, Verlauf, Änderungen und später KI-Auswertung.
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap align-self-xl-start">
                    <button class="btn btn-primary" @onclick="ScanCurrentProject">
                        Projekt erneut prüfen
                    </button>

                    <a class="btn btn-outline-secondary" href="/projektpruefung">
                        Anderen Projektordner prüfen
                    </a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(InfoMessage))
        {
            <div class="alert alert-success">
                @InfoMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        <LatestProjectCheckSummaryCard ProjectState="@LatestProjectState" />

        <ProjectAnalysisSummaryCard ProjectState="@LatestProjectState" />

        <ProjectChangeSummaryCard 
            LatestProjectState="@LatestProjectState"
            PreviousProjectState="@PreviousProjectState"
            ChangeSummary="@ChangesSinceLastCheck" />

        <ProjectStatesOverviewCard ProjectStates="@CurrentProjectStates" />

        <ProjectNextAreasCard />

        <ProjectInformationCard Project="@CurrentProject" />
    }
</div>
