@page "/projekte/{ProjectId:guid}/dateien"
@namespace PMD.App.Features.Projects.Pages
@using PMD.App.Features.Projects.Components

<PageTitle>PMD - Dateien</PageTitle>

<div class="container-fluid pmd-project-page">
    @if (CurrentProject is null)
    {
        <div class="alert alert-warning">
            Das Projekt wurde nicht gefunden. Es ist nicht mehr in der Projektliste vorhanden.
        </div>
    }
    else
    {
        <div class="mb-4">
            <div class="text-muted small mb-1">PMD - Dateien</div>

            <div class="d-flex flex-column flex-xl-row justify-content-between gap-3">
                <div>
                    <h1>Dateien</h1>
                    <p class="text-muted mb-0">
                        Dateiansicht für @CurrentProject.Name. Diese Ansicht basiert auf der letzten gespeicherten Prüfung.
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap align-self-xl-start">
                    <a class="btn btn-outline-secondary" href="@($"/projekte/{CurrentProject.Id}")">
                        Zurück zum Projekt
                    </a>

                    <a class="btn btn-outline-primary" href="@ProjectChangesLink">
                        Änderungen ansehen
                    </a>

                    <a class="btn btn-outline-secondary" href="/projektpruefung">
                        Anderen Projektordner prüfen
                    </a>
                </div>
            </div>
        </div>

        @if (LatestProjectState is null)
        {
            <div class="alert alert-info">
                Für dieses Projekt gibt es noch keine gespeicherte Prüfung. Prüfe das Projekt zuerst, damit PMD die Dateien anzeigen kann.
            </div>
        }
        else
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Grundlage</h2>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        Diese Dateiansicht nutzt die zuletzt gespeicherte Prüfung aus SQLite.
                    </p>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Letzte Prüfung</div>
                                <div class="fw-semibold">
                                    @ProjectOverviewFormatter.FormatDateTime(LatestProjectState.ScannedAt)
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Dateien</div>
                                <div class="fw-semibold">@Files.Count</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Gesamtgröße</div>
                                <div class="fw-semibold">
                                    @ProjectOverviewFormatter.FormatFileSize(LatestProjectState.TotalSizeInBytes)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (HasFocusedFileRequest)
            {
                <div class="alert @(SelectedFile is not null ? "alert-primary" : "alert-warning") mb-4">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                        <div>
                            <div class="fw-semibold mb-1">
                                @(OpenedFromChanges ? "Aus Änderungen geöffnet" : "Datei direkt geöffnet")
                            </div>

                            @if (SelectedFile is not null)
                            {
                                <div>
                                    PMD hat die Datei gefunden und direkt ausgewählt:
                                </div>
                            }
                            else
                            {
                                <div>
                                    PMD konnte diese Datei in der letzten Prüfung nicht finden:
                                </div>
                            }

                            <code class="d-block mt-2 text-break">
                                @FocusedFileDisplayPath
                            </code>
                        </div>

                        <div class="d-flex gap-2 flex-wrap align-self-lg-start">
                            @if (OpenedFromChanges)
                            {
                                <a class="btn btn-outline-primary btn-sm"
                                   href="@ProjectChangesLink">
                                    Zurück zu Änderungen
                                </a>
                            }

                            <a class="btn btn-outline-secondary btn-sm"
                               href="@ProjectFilesLink">
                                Fokus lösen
                            </a>
                        </div>
                    </div>
                </div>
            }

            <div class="card mb-4">
                <div class="card-header">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                        <div>
                            <h2 class="h5 mb-1">Dateien durchsuchen</h2>
                            <div class="text-muted small">
                                Suche gezielt nach Dateien, filtere nach Dateityp oder ändere die Sortierung.
                            </div>
                        </div>

                        <span class="badge bg-light text-dark border align-self-start align-self-lg-center">
                            @FilteredFiles.Count Treffer
                        </span>
                    </div>
                </div>

                <div class="card-body">
                    <ProjectFileSearchBar SearchText="@SearchText"
                                          SelectedExtension="@SelectedExtension"
                                          SelectedSortMode="@SelectedSortMode"
                                          AvailableExtensions="AvailableExtensions"
                                          HasActiveFilters="HasActiveFilters"
                                          OnSearchTextChanged="OnSearchTextChanged"
                                          OnSelectedExtensionChanged="OnSelectedExtensionChanged"
                                          OnSelectedSortModeChanged="OnSelectedSortModeChanged"
                                          OnClearFilters="ClearFilters" />

                    <div class="row g-3">
                        <div class="col-12 col-xl-6">
                            <ProjectFileList TotalFileCount="Files.Count"
                                             FilteredFiles="FilteredFiles"
                                             VisibleFiles="VisibleFiles"
                                             SelectedFile="SelectedFile"
                                             SelectedSortLabel="@SelectedSortLabel"
                                             OnSelectFile="SelectFile" />
                        </div>

                        <div class="col-12 col-xl-6">
                            <ProjectFileDetailCard SelectedFile="SelectedFile"
                                                   SelectedFileContentResult="SelectedFileContentResult"
                                                   OnLoadPreview="LoadSelectedFilePreview" />
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>