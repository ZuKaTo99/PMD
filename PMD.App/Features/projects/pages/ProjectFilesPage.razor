@page "/projekte/{ProjectId:guid}/dateien"
@namespace PMD.App.Features.Projects.Pages
@using PMD.App.Features.Projects.Components

<PageTitle>PMD - Dateien</PageTitle>

<div class="container-fluid pmd-project-page">
    @if (CurrentProject is null)
    {
        <div class="alert alert-warning">
            Das Projekt wurde nicht gefunden. Es ist nicht mehr in der Projektliste vorhanden.
        </div>
    }
    else
    {
        <div class="mb-4">
            <div class="text-muted small mb-1">PMD - Dateien</div>

            <div class="d-flex flex-column flex-xl-row justify-content-between gap-3">
                <div>
                    <h1>Dateien</h1>
                    <p class="text-muted mb-0">
                        Dateiansicht für @CurrentProject.Name. Diese Ansicht basiert auf der letzten gespeicherten Prüfung.
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap align-self-xl-start">
                    <a class="btn btn-outline-secondary" href="@($"/projekte/{CurrentProject.Id}")">
                        Zurück zum Projekt
                    </a>

                    <a class="btn btn-outline-secondary" href="/projektpruefung">
                        Anderen Projektordner prüfen
                    </a>
                </div>
            </div>
        </div>

        @if (LatestProjectState is null)
        {
            <div class="alert alert-info">
                Für dieses Projekt gibt es noch keine gespeicherte Prüfung. Prüfe das Projekt zuerst, damit PMD die Dateien anzeigen kann.
            </div>
        }
        else
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Grundlage</h2>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        Diese Dateiansicht nutzt die zuletzt gespeicherte Prüfung aus SQLite.
                    </p>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Letzte Prüfung</div>
                                <div class="fw-semibold">
                                    @ProjectOverviewFormatter.FormatDateTime(LatestProjectState.ScannedAt)
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Dateien</div>
                                <div class="fw-semibold">@Files.Count</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Gesamtgröße</div>
                                <div class="fw-semibold">
                                    @ProjectOverviewFormatter.FormatFileSize(LatestProjectState.TotalSizeInBytes)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                        <div>
                            <h2 class="h5 mb-1">Dateien durchsuchen</h2>
                            <div class="text-muted small">
                                Suche gezielt nach Dateien, filtere nach Dateityp oder ändere die Sortierung.
                            </div>
                        </div>

                        <span class="badge bg-light text-dark border align-self-start align-self-lg-center">
                            @FilteredFiles.Count Treffer
                        </span>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-xl-5">
                            <label class="form-label" for="file-search">Suche</label>
                            <input id="file-search"
                                   class="form-control"
                                   placeholder="Dateiname oder Pfad suchen..."
                                   value="@SearchText"
                                   @oninput="OnSearchTextChanged" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label" for="file-extension-filter">Dateityp</label>
                            <select id="file-extension-filter"
                                    class="form-select"
                                    value="@SelectedExtension"
                                    @onchange="OnSelectedExtensionChanged">
                                <option value="">Alle Dateitypen</option>

                                @foreach (string extension in AvailableExtensions)
                                {
                                    <option value="@extension">
                                        @ProjectOverviewFormatter.FormatExtension(extension)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6 col-xl-2">
                            <label class="form-label" for="file-sort-mode">Sortieren nach</label>
                            <select id="file-sort-mode"
                                    class="form-select"
                                    value="@SelectedSortMode"
                                    @onchange="OnSelectedSortModeChanged">
                                <option value="@SortByPath">Pfad</option>
                                <option value="@SortByExtension">Dateityp</option>
                                <option value="@SortBySizeDescending">Größe</option>
                                <option value="@SortByLastChangedDescending">Zuletzt geändert</option>
                            </select>
                        </div>

                        <div class="col-12 col-xl-2 d-flex align-items-end">
                            <button class="btn btn-outline-secondary w-100"
                                    type="button"
                                    @onclick="ClearFilters"
                                    disabled="@(!HasActiveFilters)">
                                Filter zurücksetzen
                            </button>
                        </div>
                    </div>

                    @if (Files.Count == 0)
                    {
                        <p class="text-muted mb-0">
                            In der letzten Prüfung wurden keine Dateien gespeichert.
                        </p>
                    }
                    else if (FilteredFiles.Count == 0)
                    {
                        <div class="alert alert-info mb-0">
                            Für diese Suche wurden keine Dateien gefunden.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-3">
                            <div class="text-muted small">
                                @FilteredFiles.Count Treffer · sortiert nach @SelectedSortLabel
                            </div>

                            @if (FilteredFiles.Count > VisibleFiles.Count)
                            {
                                <div class="text-muted small">
                                    @VisibleFiles.Count von @FilteredFiles.Count sichtbar
                                </div>
                            }
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-xl-8">
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var file in VisibleFiles)
                                    {
                                        <div class="@GetFileCardCssClass(file)">
                                            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                                                <div class="min-w-0">
                                                    <div class="text-truncate">
                                                        <code>@file.RelativePath</code>
                                                    </div>

                                                    <div class="text-muted small mt-1">
                                                        @ProjectOverviewFormatter.FormatExtension(file.Extension)
                                                        · @ProjectOverviewFormatter.FormatFileSize(file.SizeInBytes)
                                                        · geändert @ProjectOverviewFormatter.FormatDateTime(file.LastChangedAt)
                                                    </div>
                                                </div>

                                                <div class="align-self-lg-start">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            type="button"
                                                            @onclick="() => SelectFile(file)">
                                                        Details
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (FilteredFiles.Count > VisibleFiles.Count)
                                {
                                    <div class="alert alert-secondary mt-3 mb-0">
                                        Es werden die ersten @VisibleFiles.Count von @FilteredFiles.Count Treffern angezeigt.
                                        Nutze die Suche oder den Dateityp-Filter, um die Auswahl einzugrenzen.
                                    </div>
                                }
                            </div>

                            <div class="col-12 col-xl-4">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <h3 class="h6 mb-0">Dateidetails</h3>
                                    </div>

                                    <div class="card-body">
                                        @if (SelectedFile is null)
                                        {
                                            <p class="text-muted mb-0">
                                                Wähle eine Datei aus der Liste aus, um Details zu sehen.
                                            </p>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-3">
                                                <div>
                                                    <div class="text-muted small">Dateiname</div>
                                                    <div class="fw-semibold text-break">@SelectedFile.FileName</div>
                                                </div>

                                                <div>
                                                    <div class="text-muted small">Pfad im Projekt</div>
                                                    <code class="d-block text-break">@SelectedFile.RelativePath</code>
                                                </div>

                                                <div class="row g-3">
                                                    <div class="col-12 col-md-6 col-xl-12">
                                                        <div class="border rounded p-3 h-100">
                                                            <div class="text-muted small">Dateityp</div>
                                                            <div class="fw-semibold">
                                                                @ProjectOverviewFormatter.FormatExtension(SelectedFile.Extension)
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-12 col-md-6 col-xl-12">
                                                        <div class="border rounded p-3 h-100">
                                                            <div class="text-muted small">Größe</div>
                                                            <div class="fw-semibold">
                                                                @ProjectOverviewFormatter.FormatFileSize(SelectedFile.SizeInBytes)
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-12">
                                                        <div class="border rounded p-3 h-100">
                                                            <div class="text-muted small">Zuletzt geändert</div>
                                                            <div class="fw-semibold">
                                                                @ProjectOverviewFormatter.FormatDateTime(SelectedFile.LastChangedAt)
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="alert alert-light border mb-0">
                                                    Codeansicht und Dateiaktionen werden später hier sauber ergänzt.
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>