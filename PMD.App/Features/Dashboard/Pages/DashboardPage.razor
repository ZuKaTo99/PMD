@page "/dashboard"

<PageTitle>PMD - Dashboard</PageTitle>

<div class="container-fluid pmd-page">
    <div class="mb-4">
        <div class="text-muted small mb-1">
            PMD - Dashboard
        </div>

        <h1>Dashboard</h1>

        <p class="text-muted mb-0">
            Projektübergreifende Auswertungen auf Basis deiner gespeicherten Projekte und Projektstände.
        </p>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card pmd-card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">
                        Projekte
                    </h2>

                    <p class="card-text mb-0">
                        PMD verwendet deine gespeicherten Projekte als Grundlage für gemeinsame Kennzahlen.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card pmd-card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">
                        Projektstände
                    </h2>

                    <p class="card-text mb-0">
                        Manuell gespeicherte Prüfungen bilden die Grundlage für Verläufe und Vergleiche.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card pmd-card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">
                        Änderungen
                    </h2>

                    <p class="card-text mb-0">
                        Neue, geänderte und entfernte Dateien können projektübergreifend ausgewertet werden.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
