@page "/"
@namespace PMD.App.Features.Home.Pages
@using PMD.App.Domain.Home
@using PMD.App.Features.Home.Components

<PageTitle>PMD - Home</PageTitle>

<div class="container-fluid pmd-page home-page">
    <div class="home-page-header mb-4">
        <div>
            <div class="text-muted small mb-1">
                PMD - Home
            </div>

            <h1>Willkommen bei PMD</h1>

            <p class="text-muted mb-0">
                Deine wichtigsten Projekte, letzten Prüfungen und nächsten Wege auf einen Blick.
            </p>
        </div>

        <div class="home-page-header-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    aria-expanded="@WidgetSettingsAriaExpanded"
                    aria-controls="home-widget-settings"
                    @onclick="ToggleWidgetSettings">
                @(AreWidgetSettingsOpen
                    ? "Anpassung schließen"
                    : "Widgets anpassen")
            </button>

            <a class="btn btn-primary"
               href="projektpruefung">
                Projekt prüfen
            </a>
        </div>
    </div>

    @if (AreWidgetSettingsOpen)
    {
        <div id="home-widget-settings"
             class="mb-3">
            <HomeWidgetSettingsPanel />
        </div>
    }

    @if (HasVisibleTopWidgets)
    {
        <div class="home-widget-grid mb-3">
            @foreach (HomeWidgetId widgetId in VisibleTopWidgets)
            {
                <div class="home-widget-layout @GetWidgetSizeClass(widgetId)">
                    @switch (widgetId)
                    {
                        case HomeWidgetId.ProjectOverview:
                            <HomeSummaryWidget Overview="@Overview" />
                            break;

                        case HomeWidgetId.QuickActions:
                            <HomeQuickActionsWidget MostRecentProject="@Overview.MostRecentProject" />
                            break;
                    }
                </div>
            }
        </div>
    }

    @if (HasVisibleRecentWidgets)
    {
        <div class="home-widget-grid mb-3">
            @foreach (HomeWidgetId widgetId in VisibleRecentWidgets)
            {
                <div class="home-widget-layout @GetWidgetSizeClass(widgetId)">
                    @switch (widgetId)
                    {
                        case HomeWidgetId.RecentProjects:
                            <HomeRecentProjectsWidget Projects="@Overview.RecentProjects" />
                            break;

                        case HomeWidgetId.RecentChecks:
                            <HomeRecentChecksWidget Checks="@Overview.RecentChecks" />
                            break;
                    }
                </div>
            }
        </div>
    }

    @if (!HasVisibleWidgets)
    {
        <section class="home-no-widgets mb-3"
                 aria-labelledby="home-no-widgets-title">
            <div>
                <div class="home-widget-eyebrow">
                    Home
                </div>

                <h2 id="home-no-widgets-title"
                    class="h5 mb-1">
                    Keine Widgets sichtbar
                </h2>

                <p class="text-muted small mb-0">
                    Öffne „Widgets anpassen“, um Inhalte wieder einzublenden.
                </p>
            </div>

            <button type="button"
                    class="btn btn-sm btn-primary"
                    @onclick="OpenWidgetSettings">
                Widgets auswählen
            </button>
        </section>
    }

    <div class="alert alert-info home-manual-check-note mb-0">
        <strong>Du behältst die Kontrolle:</strong>
        Projektprüfungen werden ausschließlich von dir gestartet.
        PMD erzeugt keine automatischen Projektstände im Hintergrund.
    </div>
</div>
